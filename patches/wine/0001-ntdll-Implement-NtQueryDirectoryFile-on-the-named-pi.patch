+static void dump_varargs_named_pipe_entries( const char *prefix, data_size_t size )
+{
+    fprintf( stderr, "%s{", prefix );
+    while (size)
+    {
+        const struct named_pipe_entry *entry = cur_data;
+        data_size_t entry_size;
+
+        if (size < sizeof(*entry) || size - sizeof(*entry) < entry->name_len)
+        {
+            fprintf( stderr, "***invalid***}" );
+            remove_data( size );
+            return;
+        }
+
+        fputs( "{name=L\"", stderr );
+        dump_strW( (const WCHAR *)(entry + 1), entry->name_len, stderr, "\"\"" );
+        fprintf( stderr, "\",instances=%u,max_instances=%u}", entry->instances, entry->max_instances );
+
+        entry_size = min( size, (sizeof(*entry) + entry->name_len + 3) & ~3 );
+        size -= entry_size;
+        remove_data( entry_size );
+        if (size) fputc( ',', stderr );
+    }
+    fputc( '}', stderr );
+}
