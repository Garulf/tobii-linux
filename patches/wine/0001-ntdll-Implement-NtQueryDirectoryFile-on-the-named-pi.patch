+DECL_HANDLER(get_named_pipe_entries)
+{
+    struct named_pipe_device_file *dir;
+    struct named_pipe_entry *entry;
+    struct object *obj;
+    data_size_t size, name_len, entry_size;
+    unsigned int i, count;
+    const WCHAR *name;
+    char *ptr;
+
+    dir = (struct named_pipe_device_file *)get_handle_obj( current->process, req->handle,
+                                                          FILE_LIST_DIRECTORY, &named_pipe_dir_ops );
+    if (!dir) return;
+
+    reply->first = !dir->scanned;
+    if (!dir->scanned || req->restart)
+    {
+        data_size_t mask_len = get_req_data_size() & ~(sizeof(WCHAR) - 1);
+
+        /* a restart without a search expression keeps the captured one */
+        if (!dir->scanned || mask_len)
+        {
+            WCHAR *mask = NULL;
+
+            if (mask_len && !(mask = memdup( get_req_data(), mask_len )))
+            {
+                release_object( dir );
+                return;
+            }
+            free( dir->mask );
+            dir->mask = mask;
+            dir->mask_len = mask_len;
+        }
+        dir->scanned = 1;
+        dir->index = 0;
+    }
+    dir->index += req->skip;
+
+    size = dir->mask_len;
+    if (size > get_reply_max_size())
+    {
+        release_object( dir );
+        return;
+    }
+
+    for (count = 0; (obj = find_object_index( dir->device->pipes, dir->index + count )); count++)
+    {
+        get_object_name( obj, &name_len );
+        entry_size = (sizeof(*entry) + name_len + 3) & ~3;
+        release_object( obj );
+        if (size + entry_size > get_reply_max_size()) break;
+        size += entry_size;
+    }
+    reply->entries_len = size - dir->mask_len;
+
+    if (size && (ptr = set_reply_data_size( size )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            struct named_pipe *pipe;
+
+            obj = find_object_index( dir->device->pipes, dir->index + i );
+            assert( obj && obj->ops == &named_pipe_ops );
+            pipe = (struct named_pipe *)obj;
+            name = get_object_name( obj, &name_len );
+
+            entry = (struct named_pipe_entry *)ptr;
+            entry->instances = pipe->instances;
+            entry->max_instances = pipe->maxinstances;
+            entry->name_len = name_len;
+            memcpy( entry + 1, name, name_len );
+            entry_size = (sizeof(*entry) + name_len + 3) & ~3;
+            memset( (char *)(entry + 1) + name_len, 0, entry_size - sizeof(*entry) - name_len );
+            ptr += entry_size;
+
+            release_object( obj );
+        }
+        if (dir->mask_len) memcpy( ptr, dir->mask, dir->mask_len );
+    }
+    release_object( dir );
+}
