+/***********************************************************************
+ *           put_named_pipe_entry
+ *
+ * Store a named pipe entry in the directory query buffer.
+ */
+static NTSTATUS put_named_pipe_entry( const struct named_pipe_entry *entry, void *info_ptr,
+                                      IO_STATUS_BLOCK *io, ULONG max_length, FILE_INFORMATION_CLASS class,
+                                      union file_directory_info **last_info )
+{
+    union file_directory_info *info;
+    ULONG name_len = entry->name_len, start, dir_size;
+
+    start = dir_info_align( io->Information );
+    dir_size = dir_info_size( class, 0 );
+    if (start + dir_size > max_length) return STATUS_MORE_ENTRIES;
+
+    max_length -= start + dir_size;
+    /* if this is not the first entry, fail; the first entry is always returned (but truncated) */
+    if (*last_info && name_len > max_length) return STATUS_MORE_ENTRIES;
+
+    info = (union file_directory_info *)((char *)info_ptr + start);
+    memset( info, 0, dir_size );
+
+    if (class == FileNamesInformation)
+        info->names.FileNameLength = name_len;
+    else
+    {
+        /* all the other structures start with a FileDirectoryInformation layout */
+        info->dir.EndOfFile.QuadPart = entry->instances;
+        info->dir.AllocationSize.QuadPart = (LONG)entry->max_instances;
+        info->dir.FileAttributes = FILE_ATTRIBUTE_NORMAL;
+        info->dir.FileNameLength = name_len;
+    }
+
+    memcpy( (char *)info + dir_size, entry + 1, min( name_len, max_length ) );
+    io->Information = start + dir_size + min( name_len, max_length );
+    if (*last_info) (*last_info)->next = (char *)info - (char *)*last_info;
+    *last_info = info;
+    return name_len > max_length ? STATUS_BUFFER_OVERFLOW : STATUS_SUCCESS;
+}
+
+
+/***********************************************************************
+ *           query_named_pipe_directory
+ *
+ * List the pipes of the named pipe root directory; helper for NtQueryDirectoryFile.
+ */
+static NTSTATUS query_named_pipe_directory( HANDLE handle, IO_STATUS_BLOCK *io, void *buffer,
+                                            ULONG length, FILE_INFORMATION_CLASS class,
+                                            BOOLEAN single_entry, const UNICODE_STRING *mask,
+                                            BOOLEAN restart_scan )
+{
+    static const data_size_t reply_size = 0x10000 + 0x2000;
+    union file_directory_info *last_info = NULL;
+    unsigned int status, skip = 0;
+    BOOL first = FALSE, done = FALSE, started = FALSE;
+    NTSTATUS ret = STATUS_SUCCESS;
+    char *data;
+
+    if (!(data = malloc( reply_size ))) return STATUS_NO_MEMORY;
+
+    for (;;)
+    {
+        data_size_t size = 0, pos = 0, entries_len = 0;
+        UNICODE_STRING captured;
+
+        SERVER_START_REQ( get_named_pipe_entries )
+        {
+            req->handle  = wine_server_obj_handle( handle );
+            req->restart = restart_scan;
+            req->skip    = skip;
+            if (!started && mask) wine_server_add_data( req, mask->Buffer, mask->Length );
+            if (!done) wine_server_set_reply( req, data, reply_size );
+            if (!(status = wine_server_call( req )))
+            {
+                if (!started) first = reply->first;
+                entries_len = reply->entries_len;
+                size = wine_server_reply_size( reply );
+            }
+        }
+        SERVER_END_REQ;
+        if (status || done) break;
+
+        if (!started) io->Information = 0;
+        started = TRUE;
+        restart_scan = FALSE;
+        skip = 0;
+
+        if (!entries_len) break;  /* no more entries */
+
+        captured.Buffer = (WCHAR *)(data + entries_len);
+        captured.Length = captured.MaximumLength = size - entries_len;
+
+        while (!done && pos < entries_len)
+        {
+            const struct named_pipe_entry *entry = (const struct named_pipe_entry *)(data + pos);
+
+            pos += (sizeof(*entry) + entry->name_len + 3) & ~3;
+            if (captured.Length && !match_filename( (const WCHAR *)(entry + 1),
+                                             entry->name_len / sizeof(WCHAR), &captured ))
+            {
+                skip++;
+                continue;
+            }
+            ret = put_named_pipe_entry( entry, buffer, io, length, class, &last_info );
+            if (ret == STATUS_MORE_ENTRIES)
+            {
+                ret = STATUS_SUCCESS;
+                done = TRUE;
+                break;
+            }
+            skip++;
+            if (ret == STATUS_BUFFER_OVERFLOW || single_entry) done = TRUE;
+        }
+        /* the next request commits the consumed entries */
+        if (done && !skip) break;
+    }
+    free( data );
+
+    if (status && !last_info) return status;
+    if (!last_info) ret = first ? STATUS_NO_SUCH_FILE : STATUS_NO_MORE_FILES;
+    if (ret != STATUS_NO_SUCH_FILE) io->Status = ret;
+    TRACE( "=> %x (%ld)\n", ret, io->Information );
+    return ret;
+}
+
+
 /******************************************************************************
  *              NtQueryDirectoryFile   (NTDLL.@)
  */
@@ -2978,7 +3105,12 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
     if ((status = server_get_unix_fd( handle, FILE_LIST_DIRECTORY, &fd, &needs_close, &type, NULL )))
     {
         if (status == STATUS_BAD_DEVICE_TYPE)
+        {
+            NTSTATUS pipe_status = query_named_pipe_directory( handle, io, buffer, length, info_class,
+                                                               single_entry, mask, restart_scan );
+            if (pipe_status != STATUS_OBJECT_TYPE_MISMATCH) return pipe_status;
             return server_query_directory_file( handle, io, buffer, length, info_class, single_entry, restart_scan);
+        }
         return status;
     }
 
