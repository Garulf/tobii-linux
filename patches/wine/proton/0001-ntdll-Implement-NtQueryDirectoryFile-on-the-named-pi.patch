 dlls/ntdll/unix/file.c  | 132 ++++++++++++++++++++++++++++++++
 server/named_pipe.c     |  91 ++++++++++++++++++++++
 server/protocol.def     |  21 +++++
 server/trace.c          |  27 +++++++
 5 files changed, 436 insertions(+)

diff --git a/dlls/ntdll/tests/pipe.c b/dlls/ntdll/tests/pipe.c
index e4f2248e..f2ef042b 100644
--- a/dlls/ntdll/tests/pipe.c
+++ b/dlls/ntdll/tests/pipe.c
@@ -3002,6 +3002,170 @@ static void subtest_pipe_name(const struct pipe_name_test *pnt)
     NtClose(pipe);
 }
 
+static void check_pipe_dir_entries( const void *buffer, ULONG size, FILE_INFORMATION_CLASS class,
+                                    const WCHAR **names, BOOL *found, unsigned int count )
+{
+    const FILE_DIRECTORY_INFORMATION *dir_info;
+    const WCHAR *name;
+    ULONG name_len, offset = 0;
+    unsigned int i;
+
+    for (;;)
+    {
+        dir_info = (const FILE_DIRECTORY_INFORMATION *)((const char *)buffer + offset);
+        ok( offset < size, "entry offset %lu out of %lu\n", offset, size );
+        if (offset >= size) break;
+
+        if (class == FileBothDirectoryInformation)
+        {
+            const FILE_BOTH_DIRECTORY_INFORMATION *both = (const void *)dir_info;
+            name = both->FileName;
+            name_len = both->FileNameLength;
+            ok( !both->ShortNameLength, "got short name length %u\n", both->ShortNameLength );
+        }
+        else if (class == FileFullDirectoryInformation)
+        {
+            const FILE_FULL_DIRECTORY_INFORMATION *full = (const void *)dir_info;
+            name = full->FileName;
+            name_len = full->FileNameLength;
+        }
+        else
+        {
+            name = dir_info->FileName;
+            name_len = dir_info->FileNameLength;
+        }
+
+        for (i = 0; i < count; i++)
+        {
+            if (name_len != wcslen( names[i] ) * sizeof(WCHAR) ||
+                wcsnicmp( name, names[i], name_len / sizeof(WCHAR) )) continue;
+            ok( !found[i], "%s listed twice\n", debugstr_w(names[i]) );
+            found[i] = TRUE;
+            ok( dir_info->EndOfFile.QuadPart == i + 1, "%s: got EndOfFile %s\n",
+                debugstr_w(names[i]), wine_dbgstr_longlong( dir_info->EndOfFile.QuadPart ) );
+            ok( dir_info->AllocationSize.QuadPart == 3, "%s: got AllocationSize %s\n",
+                debugstr_w(names[i]), wine_dbgstr_longlong( dir_info->AllocationSize.QuadPart ) );
+            break;
+        }
+        ok( i < count, "unexpected entry %s\n", debugstr_wn(name, name_len / sizeof(WCHAR)) );
+
+        if (!dir_info->NextEntryOffset) break;
+        offset += dir_info->NextEntryOffset;
+    }
+}
+
+static void test_pipe_directory(void)
+{
+    static const FILE_INFORMATION_CLASS classes[] =
+    {
+        FileDirectoryInformation, FileBothDirectoryInformation, FileFullDirectoryInformation
+    };
+    WCHAR pipe_names[2][64], path[MAX_PATH], mask_str[64];
+    const WCHAR *names[2] = { pipe_names[0], pipe_names[1] };
+    HANDLE pipes[3], dir, find;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name, mask;
+    IO_STATUS_BLOCK io;
+    WIN32_FIND_DATAW data;
+    BOOL found[2];
+    ULONG_PTR info_len;
+    char buffer[4096];
+    unsigned int i, j;
+    NTSTATUS status;
+
+    swprintf( mask_str, ARRAY_SIZE(mask_str), L"wine_test_pipe_dir_%lx_*", GetCurrentProcessId() );
+    for (i = 0; i < 2; i++)
+        swprintf( pipe_names[i], ARRAY_SIZE(pipe_names[i]), L"wine_test_pipe_dir_%lx_%u",
+                  GetCurrentProcessId(), i );
+
+    swprintf( path, ARRAY_SIZE(path), L"\\\\.\\pipe\\%s", pipe_names[0] );
+    pipes[0] = CreateNamedPipeW( path, PIPE_ACCESS_INBOUND, PIPE_TYPE_BYTE | PIPE_WAIT, 3, 1024, 1024, 0, NULL );
+    ok( pipes[0] != INVALID_HANDLE_VALUE, "CreateNamedPipe failed, error %lu\n", GetLastError() );
+    swprintf( path, ARRAY_SIZE(path), L"\\\\.\\pipe\\%s", pipe_names[1] );
+    for (i = 1; i < 3; i++)
+    {
+        pipes[i] = CreateNamedPipeW( path, PIPE_ACCESS_INBOUND, PIPE_TYPE_BYTE | PIPE_WAIT, 3, 1024, 1024, 0, NULL );
+        ok( pipes[i] != INVALID_HANDLE_VALUE, "CreateNamedPipe failed, error %lu\n", GetLastError() );
+    }
+
+    pRtlInitUnicodeString( &name, L"\\Device\\NamedPipe\\" );
+    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = NtOpenFile( &dir, FILE_LIST_DIRECTORY | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                         FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT );
+    ok( !status, "NtOpenFile failed: %#lx\n", status );
+
+    pRtlInitUnicodeString( &mask, mask_str );
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        winetest_push_context( "class %u", classes[i] );
+        memset( found, 0, sizeof(found) );
+        memset( &io, 0xcc, sizeof(io) );
+        status = NtQueryDirectoryFile( dir, NULL, NULL, NULL, &io, buffer, sizeof(buffer), classes[i],
+                                       FALSE, &mask, TRUE );
+        ok( !status, "got %#lx\n", status );
+        ok( io.Status == status, "got io status %#lx\n", io.Status );
+        if (!status) check_pipe_dir_entries( buffer, io.Information, classes[i], names, found, 2 );
+        ok( found[0] && found[1], "pipes not listed: %d %d\n", found[0], found[1] );
+
+        status = NtQueryDirectoryFile( dir, NULL, NULL, NULL, &io, buffer, sizeof(buffer), classes[i],
+                                       FALSE, &mask, FALSE );
+        ok( status == STATUS_NO_MORE_FILES, "got %#lx\n", status );
+        winetest_pop_context();
+    }
+
+    memset( found, 0, sizeof(found) );
+    for (j = 0; j < 2; j++)
+    {
+        status = NtQueryDirectoryFile( dir, NULL, NULL, NULL, &io, buffer, sizeof(buffer),
+                                       FileDirectoryInformation, TRUE, &mask, j == 0 );
+        ok( !status, "got %#lx\n", status );
+        if (status) continue;
+        info_len = io.Information;
+        ok( info_len == offsetof( FILE_DIRECTORY_INFORMATION, FileName[wcslen( pipe_names[0] )] ),
+            "got length %Iu\n", info_len );
+        check_pipe_dir_entries( buffer, io.Information, FileDirectoryInformation, names, found, 2 );
+        ok( !((FILE_DIRECTORY_INFORMATION *)buffer)->NextEntryOffset, "got more than one entry\n" );
+    }
+    ok( found[0] && found[1], "pipes not listed: %d %d\n", found[0], found[1] );
+    status = NtQueryDirectoryFile( dir, NULL, NULL, NULL, &io, buffer, sizeof(buffer),
+                                   FileDirectoryInformation, TRUE, &mask, FALSE );
+    ok( status == STATUS_NO_MORE_FILES, "got %#lx\n", status );
+    NtClose( dir );
+
+    status = NtOpenFile( &dir, FILE_LIST_DIRECTORY | SYNCHRONIZE, &attr, &io, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                         FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT );
+    ok( !status, "NtOpenFile failed: %#lx\n", status );
+    pRtlInitUnicodeString( &mask, L"wine_test_pipe_dir_nonexistent" );
+    status = NtQueryDirectoryFile( dir, NULL, NULL, NULL, &io, buffer, sizeof(buffer),
+                                   FileDirectoryInformation, FALSE, &mask, TRUE );
+    ok( status == STATUS_NO_SUCH_FILE || broken( status == STATUS_NO_MORE_FILES ), "got %#lx\n", status );
+    NtClose( dir );
+
+    memset( found, 0, sizeof(found) );
+    swprintf( path, ARRAY_SIZE(path), L"\\\\.\\pipe\\%s", mask_str );
+    find = FindFirstFileW( path, &data );
+    ok( find != INVALID_HANDLE_VALUE, "FindFirstFile failed, error %lu\n", GetLastError() );
+    if (find != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            for (i = 0; i < 2; i++)
+                if (!wcsicmp( data.cFileName, pipe_names[i] )) found[i] = TRUE;
+        } while (FindNextFileW( find, &data ));
+        ok( GetLastError() == ERROR_NO_MORE_FILES, "got error %lu\n", GetLastError() );
+        FindClose( find );
+    }
+    ok( found[0] && found[1], "pipes not found: %d %d\n", found[0], found[1] );
+
+    for (i = 0; i < 3; i++) CloseHandle( pipes[i] );
+
+    swprintf( path, ARRAY_SIZE(path), L"\\\\.\\pipe\\%s", mask_str );
+    find = FindFirstFileW( path, &data );
+    ok( find == INVALID_HANDLE_VALUE, "pipes still listed\n" );
+    ok( GetLastError() == ERROR_FILE_NOT_FOUND, "got error %lu\n", GetLastError() );
+    if (find != INVALID_HANDLE_VALUE) FindClose( find );
+}
+
 static void test_pipe_names(void)
 {
     static const struct pipe_name_test tests[] = {
@@ -3323,6 +3487,7 @@ START_TEST(pipe)
